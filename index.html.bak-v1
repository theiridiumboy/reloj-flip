<!--
IMPECCABLE DIRECTION CONTRACT
THESIS: pizarra split-flap de aeropuerto real, oscura, fiel al vector de referencia (Freepik "realistic scoreboard alphabet"): una tarjeta por carácter, bisel metálico, sombra 3D real.
OWN-WORLD: fondo carbón #17181a, tarjetas casi negras con gradiente de bisel (#2c2e33→#1a1b1e), texto blanco hueso, bisagra metálica central que sobresale, sombra de caída bajo cada tarjeta.
STORY: el lector entiende, de un vistazo, cuántos días/horas/minutos/segundos lleva activa la mesa de diálogo en Venezuela.
FIRST VIEWPORT: banner único 980x200, título centrado arriba, 9 tarjetas flip (3 Días + 2 Horas + 2 Minutos + 2 Segundos) en fila, labels debajo de cada grupo.
FORM: extensión precisa de un vector de referencia entregado por el usuario (alfabeto/números estilo scoreboard realista, Freepik), un carácter por tarjeta.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Mesa de Diálogo — Tiempo en curso</title>
<style>
  :root{
    --bg: #2c2d30;
    --card-hi: #313236;
    --card-lo: #1c1d20;
    --frame: #050505;
    --ink: #f3f2ee;
    --label: #9096a1;
    --tab-hi: #45474d;
    --tab-lo: #0c0d0e;
  }

  *{ box-sizing: border-box; }

  html,body{
    margin:0;
    padding:0;
    background: var(--bg);
    width: 100%;
  }

  /* Responsive wrapper: scales the whole 980x200 banner as one rigid unit,
     like a photo, instead of reflowing its layout at breakpoints. Nothing
     inside .banner changes at any size — every pixel-tuned value in this
     file (fonts, gaps, the seam, animation timing) stays exactly as
     verified. container-type + cqw let .banner compute its own scale
     factor from this wrapper's real rendered width, continuously, with no
     breakpoints. aspect-ratio reserves the right box before paint so nothing
     jumps. */
  .banner-wrap{
    container-type: inline-size;
    width: 100%;
    max-width: 980px;
    aspect-ratio: 980 / 200;
    margin: 0 auto;
    overflow: hidden;
    background: var(--bg);
  }

  .banner{
    position: relative;
    width: 980px;
    height: 200px;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: "Arial Narrow", Arial, "Helvetica Neue", sans-serif;
    -webkit-font-smoothing: antialiased;
    transform: scale(calc(100cqw / 980px));
    transform-origin: top left;
  }

  /* credit, bottom-right, one line. Tight on purpose: the card row is
     centered in the 980px banner, leaving only ~94px of free margin to
     the right of the last card — Rory chose to keep that clock spacing
     untouched rather than free up more room for this, so the credit sits
     at the small end of legible. The logo itself is a recolored variant
     (lp-logo-light.png, not the original dark-charcoal wordmark): the
     grayscale "lapatilla" text was remapped to a light ink color while
     the red/green watermelon pixels were left alone, which is what makes
     it readable directly on --bg without a white pill behind it. */
  .credit{
    position: absolute;
    right: 5px;
    bottom: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 3px;
  }

  .credit-label{
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--label);
    white-space: nowrap;
  }

  .credit img{
    display: block;
    height: 9px;
    width: auto;
  }

  .title{
    align-self: flex-start;
    margin: 0 0 16px 94px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-align: left;
  }

  .board{
    display: flex;
    align-items: flex-start;
    gap: 26px;
  }

  .unit{
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .digits{
    display: flex;
    gap: 6px;
  }

  .label{
    margin-top: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--label);
  }

  /* --- flip digit card, one character --- */
  .digit{
    position: relative;
    width: 76px;
    height: 128px;
    perspective: 340px;
    border-radius: 13px;
    background: var(--frame);
    box-shadow: 0 7px 12px rgba(0,0,0,0.6);
    /* overridden inline to a fast value during the page-load cascade
       (see script), then cleared so normal per-second ticks fall at the
       mechanical speed below. */
    --fall-duration: 0.32s;
  }

  /* thick black outer frame (the vector's most distinctive trait), then a
     thin lighter bevel ring just inside it tracing the rounded corners */
  .digit::before{
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: 10px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.14), inset 0 0 0 1px rgba(255,255,255,0.05);
    z-index: 7;
    pointer-events: none;
  }

  /* ONE static face, showing the CURRENT value, full card — no top/bottom
     split content. Physically the seam is just a line printed across a
     single card; it never needs two independently-clipped copies of the
     glyph. That's also what makes desync impossible: one element, one
     text, always. */
  .digit .face{
    position: absolute;
    inset: 3px;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--card-hi) 0%, var(--card-lo) 100%);
  }

  .digit .face span,
  .digit .leaf span{
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 76px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  /* the seam: a solid black gap band, full width, drawn over everything */
  .digit .seam{
    position: absolute;
    left: -3px;
    right: -3px;
    top: 50%;
    height: 4px;
    margin-top: -2px;
    background: var(--frame);
    z-index: 6;
  }

  /* the hinge: two short dark tabs at the seam, bolted past the card's own
     edges, NOT a single bar crossing the tarjeta */
  .digit .tab{
    position: absolute;
    top: 50%;
    width: 15px;
    height: 13px;
    margin-top: -6.5px;
    border-radius: 3px;
    background: linear-gradient(180deg, var(--tab-hi) 0%, #202124 55%, var(--tab-lo) 100%);
    box-shadow: 0 1px 2px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.12);
    z-index: 7;
  }
  .digit .tab.left{ left: -6px; }
  .digit .tab.right{ right: -6px; }

  /* the ONE rigid flap that falls: one physical card, hinged at its own
     CENTER (the seam), rotating as a single piece — not two separately
     timed top/bottom leaves. This is what "una tarjeta cae" means
     physically: one card, one motion. */
  .digit .leaf{
    position: absolute;
    inset: 3px;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(180deg, #35373d 0%, #1a1b1e 100%);
    transform-origin: center;
    transform: rotateX(0deg);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    z-index: 5;
  }
  .digit.flipping .leaf{
    animation: fallCard var(--fall-duration) linear forwards;
  }

  /* mechanical, not digital: a tiny anticipation lift (the card releasing
     from its catch) before gravity takes over — real split-flap leaves
     visibly "kick" back a couple degrees at the release, they don't just
     start smoothly accelerating from a dead stop. The fall itself is a
     steep ease-in (gravity, not a synthetic ease-out glide) and stops
     abruptly at the end, the way a card hitting a mechanical stop does —
     no soft deceleration. Per-keyframe animation-timing-function gives
     each segment its own character instead of one blended curve. */
  @keyframes fallCard{
    0%{ transform: rotateX(3deg); box-shadow: 0 2px 3px rgba(0,0,0,0.3); animation-timing-function: ease-out; }
    12%{ transform: rotateX(0deg); box-shadow: 0 3px 5px rgba(0,0,0,0.35); animation-timing-function: cubic-bezier(0.7, 0, 1, 1); }
    55%{ box-shadow: 0 17px 18px rgba(0,0,0,0.6); }
    100%{ transform: rotateX(-90deg); box-shadow: 0 0 0 rgba(0,0,0,0); }
  }

  @media (prefers-reduced-motion: reduce){
    .digit.flipping .leaf{
      animation: none;
    }
  }

  .sr-only{
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
</head>
<body>

<div class="banner-wrap">
<div class="banner">
  <p class="title">La mesa de diálogo en Venezuela inició hace:</p>
  <p class="sr-only" id="board-status" aria-live="polite"></p>
  <div class="board" id="board" aria-hidden="true">
    <div class="unit">
      <div class="digits" data-unit="days">
        <div class="digit" data-pos="0"></div>
        <div class="digit" data-pos="1"></div>
        <div class="digit" data-pos="2"></div>
      </div>
      <span class="label">Días</span>
    </div>
    <div class="unit">
      <div class="digits" data-unit="hours">
        <div class="digit" data-pos="0"></div>
        <div class="digit" data-pos="1"></div>
      </div>
      <span class="label">Horas</span>
    </div>
    <div class="unit">
      <div class="digits" data-unit="minutes">
        <div class="digit" data-pos="0"></div>
        <div class="digit" data-pos="1"></div>
      </div>
      <span class="label">Minutos</span>
    </div>
    <div class="unit">
      <div class="digits" data-unit="seconds">
        <div class="digit" data-pos="0"></div>
        <div class="digit" data-pos="1"></div>
      </div>
      <span class="label">Segundos</span>
    </div>
  </div>
  <div class="credit">
    <span class="credit-label">Desarrollado por</span>
    <img src="data:image/png;base64," alt="LaPatilla.com">
  </div>
</div>
</div>

<script>
(function(){
  // ponytail: fecha de inicio fija al momento de carga; ajustar a fecha real de arranque de la mesa cuando se conozca.
  var START = Date.now();

  function buildDigit(el, value){
    el.innerHTML =
      '<div class="face"><span>' + value + '</span></div>' +
      '<div class="leaf"><span>' + value + '</span></div>' +
      '<div class="seam"></div>' +
      '<div class="tab left"></div>' +
      '<div class="tab right"></div>';
    el.dataset.value = value;
  }

  var NORMAL_FALL_MS = 320;

  // durationMs lets the page-load cascade flip much faster than the normal
  // per-second fall; omit it for the regular mechanical speed.
  function setDigit(el, value, durationMs){
    value = String(value);
    var duration = durationMs || NORMAL_FALL_MS;

    if(!el.dataset.value){
      buildDigit(el, value);
      return;
    }
    if(el.dataset.value === value) return;

    // a previous flip on this card hasn't settled yet (e.g. the tab was
    // throttled in the background and several ticks landed at once): snap
    // straight to the new value instead of restarting mid-rotation.
    if(el.classList.contains('flipping')){
      clearTimeout(el._settleTimer);
      el.classList.remove('flipping');
      snapDigit(el, value);
      el.dataset.value = value;
      return;
    }

    el.style.setProperty('--fall-duration', (duration / 1000) + 's');

    // the leaf (one rigid card) shows the OLD value and falls away; the
    // static face underneath is updated to NEW now since it's hidden
    // until the leaf has rotated past it.
    el.querySelector('.leaf span').textContent = el.dataset.value;
    el.querySelector('.face span').textContent = value;

    void el.offsetWidth; // restart animation
    el.classList.add('flipping');

    el.dataset.value = value;

    el._settleTimer = setTimeout(function(){
      el.classList.remove('flipping');
      snapDigit(el, value);
    }, duration + 20);
  }

  // keeps face + leaf in sync so the card is consistent at rest — the leaf
  // is what's actually visible when idle (it sits flat over the face), so
  // it must carry the current value too, not just the face.
  function snapDigit(el, value){
    el.querySelector('.face span').textContent = value;
    el.querySelector('.leaf span').textContent = value;
  }

  function setUnit(unitEl, num, digits, durationMs){
    var str = String(num).padStart(digits, '0');
    var cards = unitEl.querySelectorAll('.digit');
    for(var i = 0; i < cards.length; i++){
      setDigit(cards[i], str[i], durationMs);
    }
  }

  var board = document.getElementById('board');
  var daysEl = board.querySelector('[data-unit="days"]');
  var hoursEl = board.querySelector('[data-unit="hours"]');
  var minutesEl = board.querySelector('[data-unit="minutes"]');
  var secondsEl = board.querySelector('[data-unit="seconds"]');

  var statusEl = document.getElementById('board-status');
  var lastStatusMinute = -1;

  function tick(){
    var elapsed = Math.floor((Date.now() - START) / 1000);
    var days = Math.floor(elapsed / 86400);
    var hours = Math.floor((elapsed % 86400) / 3600);
    var minutes = Math.floor((elapsed % 3600) / 60);
    var seconds = elapsed % 60;

    setUnit(daysEl, days, 3);
    setUnit(hoursEl, hours, 2);
    setUnit(minutesEl, minutes, 2);
    setUnit(secondsEl, seconds, 2);

    var totalMinutes = Math.floor(elapsed / 60);
    if(totalMinutes !== lastStatusMinute){
      lastStatusMinute = totalMinutes;
      statusEl.textContent = 'Mesa de diálogo en Venezuela activa desde hace ' +
        days + ' días, ' + hours + ' horas y ' + minutes + ' minutos.';
    }
  }

  function pad(n, digits){
    return String(n).padStart(digits, '0');
  }

  function currentTarget(){
    var elapsed = Math.floor((Date.now() - START) / 1000);
    return {
      days: Math.floor(elapsed / 86400),
      hours: Math.floor((elapsed % 86400) / 3600),
      minutes: Math.floor((elapsed % 3600) / 60),
      seconds: elapsed % 60
    };
  }

  // page-load cascade: every card starts at 0 and spins through a burst of
  // quick, staggered flips (left to right) before landing on the real
  // current value, then normal per-second ticking takes over. Purely a
  // decorative "catching up" reveal — the intermediate digits shown during
  // the spin are not a literal count-up (days could be large), just motion.
  var SPIN_STEPS = 6;
  var SPIN_STEP_MS = 100;
  var CASCADE_STAGGER_MS = 70;

  function randomDigitExcept(exclude){
    var d;
    do { d = String(Math.floor(Math.random() * 10)); } while(d === exclude);
    return d;
  }

  function burstCard(el, finalValue, startDelay){
    setTimeout(function(){
      var i = 0;
      function step(){
        if(i < SPIN_STEPS - 1){
          setDigit(el, randomDigitExcept(el.dataset.value), SPIN_STEP_MS);
          i++;
          setTimeout(step, SPIN_STEP_MS + 20);
        } else {
          setDigit(el, finalValue, SPIN_STEP_MS);
        }
      }
      step();
    }, startDelay);
  }

  function startNormalTicking(){
    tick();
    setInterval(tick, 1000);
  }

  function runIntro(){
    var t = currentTarget();
    var targets = (pad(t.days, 3) + pad(t.hours, 2) + pad(t.minutes, 2) + pad(t.seconds, 2)).split('');
    var allCards = Array.prototype.slice.call(board.querySelectorAll('.digit'));

    allCards.forEach(function(card){ buildDigit(card, '0'); });
    allCards.forEach(function(card, idx){
      burstCard(card, targets[idx], idx * CASCADE_STAGGER_MS);
    });

    var totalIntroMs = (allCards.length - 1) * CASCADE_STAGGER_MS + SPIN_STEPS * (SPIN_STEP_MS + 20) + 100;
    setTimeout(function(){
      allCards.forEach(function(card){ card.style.removeProperty('--fall-duration'); });
      startNormalTicking();
    }, totalIntroMs);
  }

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduceMotion){
    startNormalTicking();
  } else {
    runIntro();
  }
})();
</script>

</body>
</html>
